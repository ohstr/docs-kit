---
// Overrides Starlight's own SiteTitle to add a small "latest release" pill
// next to the title. Lives here (not a custom Header override) because
// `title-wrapper` — SiteTitle's home in Header.astro — is the one header
// slot Starlight never hides on narrow viewports (it hides the search/
// socials/theme group instead), so the badge reaches mobile for free
// instead of needing a second, hand-maintained mobile copy — same reasoning
// as the sidebar Reference group in astro.config.mjs.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import release from '../generated/release.json';
---

<div class="site-title-row">
	<Default {...Astro.props} />
	{
		release.tag && (
			<a class="release-badge" href={release.url} rel="noopener" title={`Latest release: ${release.tag}`}>
				{release.tag}
			</a>
		)
	}
</div>

<style>
	@layer starlight.core {
		.site-title-row {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			min-width: 0;
		}
		.release-badge {
			flex-shrink: 0;
			display: inline-flex;
			align-items: center;
			padding: 0.15rem 0.6rem;
			border-radius: 999px;
			background: var(--sl-color-bg-accent);
			color: var(--sl-color-accent-low);
			font-size: var(--sl-text-xs);
			font-weight: 600;
			line-height: 1.4;
			text-decoration: none;
			white-space: nowrap;
			transition: opacity 0.2s ease;
		}
		.release-badge:hover,
		.release-badge:focus-visible {
			opacity: 0.8;
		}
	}
</style>
